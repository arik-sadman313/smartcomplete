+#!/usr/bin/env python3
+"""Exercise the installer's actual detection pipeline without running installation."""
+import os
+from pathlib import Path
+import re
+import shlex
+import subprocess
+import sys
+import unittest
+
+
+INSTALLER = Path(__file__).resolve().parents[1] / "scripts" / "install.sh"
+# A default SIGPIPE disposition reproduces a Unix producer interrupted by grep -q.
+# Output greatly exceeds a pipe buffer, so an early reader exit cannot race past it.
+PRODUCER = r"""
+import os
+import signal
+signal.signal(signal.SIGPIPE, signal.SIG_DFL)
+if os.environ['DETECTION_CASE'] != 'absent':
+    os.write(1, b'linuxcomplete\n')
+chunk = b'x' * 4095 + b'\n'
+for _ in range(8192):
+    os.write(1, chunk)
+raise SystemExit(7 if os.environ['DETECTION_CASE'] == 'error' else 0)
+"""
+
+
+class InstallerDetectionRegression(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        source = INSTALLER.read_text(encoding="utf-8")
+        matches = re.findall(
+            r'^\s*if (fcitx5-diagnose[^\n]+); then\s*$', source, re.MULTILINE
+        )
+        if len(matches) != 1:
+            raise AssertionError("Expected exactly one installer detection pipeline")
+        cls.pipeline = matches[0]
+
+    def run_detection(self, case):
+        # Shadow only the external diagnostic command. Execute the real installer
+        # condition under its pipefail semantics, with no system state changes.
+        script = (
+            "set -o pipefail\n"
+            "fcitx5-diagnose() { "
+            + shlex.quote(sys.executable) + " -c " + shlex.quote(PRODUCER)
+            + "; }\n" + self.pipeline + "\n"
+        )
+        return subprocess.run(
+            ["bash", "-c", script],
+            env={**os.environ, "DETECTION_CASE": case},
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+            timeout=15,
+            check=False,
+        )
+
+    def test_match_with_large_trailing_output_succeeds(self):
+        result = self.run_detection("present")
+        self.assertEqual(result.returncode, 0, result.stderr.decode())
+        self.assertEqual(result.stdout, b"")
+
+    def test_missing_match_fails(self):
+        result = self.run_detection("absent")
+        self.assertEqual(result.returncode, 1, result.stderr.decode())
+        self.assertEqual(result.stdout, b"")
+
+    def test_diagnostic_failure_is_not_hidden_by_match(self):
+        result = self.run_detection("error")
+        self.assertEqual(result.returncode, 7, result.stderr.decode())
+
+
+if __name__ == "__main__":
+    unittest.main()
